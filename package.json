{
  "name": "cadence-typescript-client",
  "version": "0.1.0",
  "description": "TypeScript SDK foundation for Cadence clients, generated from cadence-idl.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./api/v1": {
      "types": "./dist/api/v1.d.ts",
      "import": "./dist/api/v1.js"
    },
    "./admin/v1": {
      "types": "./dist/admin/v1.d.ts",
      "import": "./dist/admin/v1.js"
    },
    "./gen/*": {
      "types": "./dist/gen/*.d.ts",
      "import": "./dist/gen/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare:idl": "node scripts/prepare-idl.mjs",
    "generate": "npm run prepare:idl && buf generate --template buf.gen.yaml idls/proto",
    "lint:proto": "buf lint",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node scripts/clean.mjs",
    "pr": "npm run generate && npm run lint:proto && npm run typecheck && npm run build && npm run test",
    "prepack": "npm run generate && npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
